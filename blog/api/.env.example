# Copy this file to .env (in this folder) and fill in your own values.
# Never commit the real .env file.

# Your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority

# A long random string used to sign login tokens, for example from: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
